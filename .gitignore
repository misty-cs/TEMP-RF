# data and caches (not distributed; see README for the sources)
data/
cache_packets/
.data_hash_cache.json
# trained models and large arrays: not in git (too large); every file is listed
# with size and SHA-256 in docs/ARTIFACTS.tsv (tools/artifact_index.py)
*.keras
*.h5
*.npz
**/modelDir/**
# ...but the small records inside modelDir ARE kept: selection tables, data-split
# group lists, normalization statistics and Phase-2 centroids
!**/modelDir/**/
!**/modelDir/*.json
!**/modelDir/*groups*.npz
!**/modelDir/*norm*.npz
!**/modelDir/ft_centroids*.npz
# top-level logs are copied to docs/logs/ by tools/collect_logs.sh;
# per-run logs inside the result folders are kept
/*.log
tools/*.log
# exploratory raw data
explore/**/head2s/
# Python / OS
__pycache__/
*.pyc
.DS_Store
